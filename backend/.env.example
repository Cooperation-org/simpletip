# SimpleTip Backend Configuration
# Copy to .env and fill in values

DATABASE_URL=postgres://simpletip:password@localhost:5432/simpletip
ENCRYPTION_KEY=  # 64-char hex: python3 -c "import secrets; print(secrets.token_hex(32))"

# Node identity
SIMPLETIP_NODE_NAME=SimpleTip by LinkedTrust
SIMPLETIP_NODE_URL=https://your-domain.com/simpletip

# Stripe (omit for demo mode)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Force demo mode even with Stripe keys
# DEMO_MODE=true

# Port (default 8046)
# PORT=8046
